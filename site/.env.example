# Self-hosted Umami analytics. Copy to .env.local for local development.
#
# Both must be set or the tracker is omitted entirely: the site then makes no
# analytics request and the privacy policy renders without its analytics
# section. Leaving these unset is a safe, honest default — see ANALYTICS.md.
#
# These are inlined into the browser bundle at BUILD time, so they must also be
# set in the GitHub Actions deploy workflow, not just here. Neither value is a
# secret: the script URL and website ID are visible in the page source anyway.

# Full URL of the tracker script on your own Umami instance.
NEXT_PUBLIC_UMAMI_SRC=https://analytics.example.eu/script.js

# The website ID Umami shows under Settings → Websites.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
